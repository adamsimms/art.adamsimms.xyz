---
import Base from '../layouts/Base.astro';
import WorkGallery from '../components/WorkGallery.astro';
import StillsThumbs from '../components/StillsThumbs.astro';
import { getCollection } from 'astro:content';
import {
	SITE_URL,
	absoluteUrl,
	isHiddenWorkSlug,
	metaDescription,
	socialImageUrl,
} from '../lib/seo';

const galleries = import.meta.glob('../content/work/*.json', { eager: true, import: 'default' });

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const gallery = galleries[`../content/work/${entry.data.galleryFile}`];
if (!gallery) throw new Error(`Gallery not found: ${entry.data.galleryFile}`);

const images = gallery.images ?? [];
const hidden = isHiddenWorkSlug(entry.data.slug);
const pageDescription = metaDescription(entry.data.seoDescription, entry.data.description);
const pageImage = socialImageUrl(entry.data.cover, entry.data.coverFallback);
const coverAlt =
	typeof images[0]?.alt === 'string' &&
	images[0].alt.trim() &&
	images[0].alt.trim().toLowerCase() !== entry.data.title.toLowerCase()
		? images[0].alt.trim()
		: `${entry.data.title} by Adam Simms`;

const orderedWork = (await getCollection('work'))
	.filter((item) => !isHiddenWorkSlug(item.data.slug))
	.sort((a, b) => b.data.order - a.data.order);

const currentIndex = orderedWork.findIndex((item) => item.data.slug === entry.data.slug);
const prevEntry =
	currentIndex === -1
		? null
		: orderedWork[(currentIndex - 1 + orderedWork.length) % orderedWork.length];
const nextEntry =
	currentIndex === -1 ? null : orderedWork[(currentIndex + 1) % orderedWork.length];

function formatDuration(seconds: number) {
	const m = Math.floor(seconds / 60);
	const s = seconds % 60;
	return `${m}:${String(s).padStart(2, '0')}`;
}

function durationLabel(seconds: number) {
	const m = Math.floor(seconds / 60);
	const s = seconds % 60;
	if (s === 0) return m === 1 ? '1 minute' : `${m} minutes`;
	const minutes = m === 1 ? '1 minute' : `${m} minutes`;
	const secondsLabel = s === 1 ? '1 second' : `${s} seconds`;
	return m === 0 ? secondsLabel : `${minutes} ${secondsLabel}`;
}

const year = entry.data.year;
const medium = entry.data.medium;
const video = entry.data.video;
const vimeoId = video?.provider === 'vimeo' ? video.id : undefined;
const videoLoops = Boolean(video?.loop);
const durationSeconds = video?.duration;
const showDuration = !videoLoops && durationSeconds != null;
const showLoop = videoLoops;
const showRuntime = showDuration || showLoop;
const stillsAfterBody = Boolean(entry.data.stillsAfterBody && vimeoId && images.length > 0);
const heroImages = stillsAfterBody ? [] : images;
const documentation = Array.isArray(gallery.documentation) ? gallery.documentation : [];
const bodyStills = stillsAfterBody ? images : documentation;

/** Assembled sibling mounts live in `dist/` after `build:full` — not available in `astro dev`. */
const projectLink =
	entry.data.slug === 'cloudberry'
		? {
				href: import.meta.env.DEV ? `${SITE_URL}/cloudberry/archive/` : '/cloudberry/archive/',
				label: 'Archive',
			}
		: entry.data.slug === 'adrift'
			? {
					href: import.meta.env.DEV ? `${SITE_URL}/adrift/experience/` : '/adrift/experience/',
					label: 'Experience',
				}
			: null;
const showMeta = Boolean(year || showRuntime || projectLink);
const descriptionParagraphs = entry.data.description
	? entry.data.description.trim().split(/\n\n+/).filter(Boolean)
	: [];
const [leadParagraph, ...moreLeadParagraphs] = descriptionParagraphs;

const creativeWorkLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: entry.data.title,
	description: pageDescription,
	url: absoluteUrl(`/${entry.data.slug}`),
	image: pageImage,
	creator: { '@type': 'Person', name: 'Adam Simms', url: SITE_URL },
	...(year ? { dateCreated: year } : {}),
	...(medium ? { material: medium } : {}),
};
---

<Base
	title={entry.data.title}
	description={pageDescription}
	image={pageImage}
	imageAlt={coverAlt}
	variant="work"
	noindex={hidden}
	jsonLd={creativeWorkLd}
>
	<article class="project" data-project-reveal>
		<header class="project-header">
			<div class="project-intro">
				<div class="project-intro__text">
					<div class="project-intro__head">
						<h1 class="project-title">{entry.data.title}</h1>
						{medium ? <p class="project-medium">{medium}</p> : null}
					</div>

					<div class="project-intro__copy" data-project-body>
						{
							showMeta ? (
								<p class="project-meta">
									{year ? <span>{year}</span> : null}
									{year && showRuntime ? (
										<span class="project-meta__sep" aria-hidden="true">
											{' '}
											·{' '}
										</span>
									) : null}
									{showLoop ? (
										<span>Loop</span>
									) : showDuration && durationSeconds != null ? (
										<span aria-label={`Duration ${durationLabel(durationSeconds)}`}>
											{formatDuration(durationSeconds)}
										</span>
									) : null}
									{(year || showRuntime) && projectLink ? (
										<span class="project-meta__sep" aria-hidden="true">
											{' '}
											·{' '}
										</span>
									) : null}
									{projectLink ? (
										<a href={projectLink.href} data-astro-reload>
											{projectLink.label}
										</a>
									) : null}
								</p>
							) : null
						}

						{leadParagraph ? <p class="project-lead">{leadParagraph}</p> : null}

						{entry.data.statement ? <p class="project-cta">{entry.data.statement}</p> : null}
					</div>
				</div>

				{
					heroImages.length > 0 || vimeoId ? (
						<div data-project-body>
							<WorkGallery
								images={heroImages}
								title={entry.data.title}
								video={
									vimeoId
										? {
												id: vimeoId,
												title: `${entry.data.title} — video`,
												poster: video?.poster || entry.data.cover,
												posterFallback:
													video?.posterFallback ||
													video?.poster ||
													entry.data.coverFallback ||
													entry.data.cover,
											}
										: null
								}
							/>
						</div>
					) : null
				}

				{
					moreLeadParagraphs.length > 0 ? (
						<div class="project-intro__more" data-project-body>
							{moreLeadParagraphs.map((paragraph) => (
								<p class="project-lead">{paragraph}</p>
							))}
						</div>
					) : null
				}
			</div>

			{
				entry.data.body ? (
					<div class="project-essay" data-project-body>
						{entry.data.body
							.trim()
							.split(/\n\n+/)
							.map((paragraph) => <p class="project-body">{paragraph}</p>)}
					</div>
				) : null
			}

			{
				bodyStills.length > 0 ? (
					<div class="project-stills" data-project-body>
						<h2 class="project-stills__title">
							{stillsAfterBody ? 'Reference' : 'Documentation'}
						</h2>
						<StillsThumbs images={bodyStills} title={entry.data.title} />
					</div>
				) : null
			}
		</header>

		{
			prevEntry && nextEntry ? (
				<nav class="project-nav" data-project-body aria-label="Project navigation">
					<a class="project-nav__link project-nav__link--prev" href={`/${prevEntry.data.slug}`}>
						<span class="project-nav__label">Previous</span>
						<span class="project-nav__title">
							<svg viewBox="0 0 9 16" width="9" height="16" aria-hidden="true" focusable="false">
								<polyline
									fill="none"
									stroke="currentColor"
									stroke-width="1.25"
									stroke-miterlimit="10"
									points="7.4,1.2 2.5,7.9 7.4,14.7"
								></polyline>
							</svg>
							{prevEntry.data.title}
						</span>
					</a>
					<a class="project-nav__link project-nav__link--next" href={`/${nextEntry.data.slug}`}>
						<span class="project-nav__label">Next</span>
						<span class="project-nav__title">
							{nextEntry.data.title}
							<svg viewBox="0 0 9 16" width="9" height="16" aria-hidden="true" focusable="false">
								<polyline
									fill="none"
									stroke="currentColor"
									stroke-width="1.25"
									stroke-miterlimit="10"
									points="1.6,1.2 6.5,7.9 1.6,14.7"
								></polyline>
							</svg>
						</span>
					</a>
				</nav>
			) : null
		}
	</article>
</Base>
