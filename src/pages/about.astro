---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { absoluteUrl, metaDescription } from '../lib/seo';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('About page not found');
const { Content } = await render(page);
const description = metaDescription(page.data.description);
const portrait = absoluteUrl('/img/about/portrait.jpg');

const statementParagraphs = page.data.statement
	? page.data.statement
			.split(/\n\n+/)
			.map((paragraph) => paragraph.trim())
			.filter(Boolean)
	: [];
const [statementLead, ...statementRest] = statementParagraphs;
---

<Base
	title={page.data.title}
	description={description}
	image={portrait}
	imageAlt="Adam Simms"
	variant="about"
>
	<article class="about">
		<h1 class="visually-hidden">{page.data.title}</h1>

		{
			statementLead ? (
				<section class="about-statement">
					<h2>Artist Statement</h2>
					<div class="about-statement__grid">
						<p class="about-statement__lead">{statementLead}</p>
						{statementRest.length ? (
							<div class="about-statement__rest">
								{statementRest.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
						) : null}
					</div>
				</section>
			) : null
		}

		<section class="about-bio-section" aria-labelledby="about-bio-heading">
			<h2 id="about-bio-heading">Biography</h2>
			<div class="about-bio-grid">
				<div class="about-bio prose">
					<Content />
				</div>
				<figure class="about-portrait">
					<picture>
						<source srcset="/img/about/portrait.avif" type="image/avif" />
						<img
							src="/img/about/portrait.jpg"
							alt="Adam Simms"
							width="1200"
							height="1800"
							loading="eager"
							decoding="async"
						/>
					</picture>
					<figcaption class="about-portrait__credit">Photo by Emilie Hébert</figcaption>
				</figure>
			</div>
		</section>
	</article>
</Base>
