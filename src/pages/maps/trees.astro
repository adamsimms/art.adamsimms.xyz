---
import Base from '../../layouts/Base.astro';
import MapsNav from '../../components/MapsNav.astro';

const title = '53 Trees';
const description =
	'Map of 53 trees tied to Pinchard’s Island and Newfoundland research sites by Adam Simms.';
const iframeSrc = 'https://www.google.com/maps/d/u/0/embed?mid=19NfRJjMQjtei3GXok6oK9WOqnsw';
---

<Base title={title} description={description} variant="cv" noindex>
	<article class="maps">
		<header class="page-header">
			<p class="maps__eyebrow">Maps</p>
			<h1>{title}</h1>
			<p class="maps__lead">{description}</p>
			<MapsNav current="trees" />
		</header>

		<div class="maps__shell">
			<iframe
				class="maps__embed"
				src={iframeSrc}
				title="53 Trees map"
				allowfullscreen
				loading="lazy"></iframe>
		</div>
	</article>
</Base>
