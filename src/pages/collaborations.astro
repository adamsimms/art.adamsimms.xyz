---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { absoluteUrl, metaDescription } from '../lib/seo';

const page = await getEntry('pages', 'collaborations');
if (!page) throw new Error('Collaborations page not found');

const title = page.data.title;
const description = metaDescription(page.data.description);
const lead = page.data.statement?.trim() || '';
const ogImage = absoluteUrl('/collaborations/goose-village/01.jpg');
const ogImageAlt = 'Goose Village publication designed by Adam Simms';

function galleryImages(slug: string) {
	const dir = path.join(process.cwd(), 'public/collaborations', slug);
	if (!fs.existsSync(dir)) return [];
	return fs
		.readdirSync(dir)
		.filter((file) => /\.jpe?g$/i.test(file))
		.sort()
		.map((file) => `/collaborations/${slug}/${file}`);
}

const projects = [
	{
		title: 'Goose Village',
		author: 'Marisa Portolese',
		slug: 'goose-village',
		imageAlt: 'Goose Village publication',
		body: 'Bilingual publication on the lost history of Goose Village in Pointe-Saint-Charles, Montreal — a neighbourhood erased by 1960s urban development.',
		specs: [
			'Softcover',
			'9 × 10 inches • 232 pages',
			'Published by Marisa Portolese, 2023',
		],
		links: [
			{ href: 'https://www.goosevillage.ca', label: 'www.goosevillage.ca' },
			{ href: 'https://www.marisaportolese.com', label: 'www.marisaportolese.com' },
		],
	},
	{
		title: 'Dear Nani',
		author: 'Zinnia Naqvi',
		slug: 'dear-nani',
		imageAlt: 'Dear Nani photobook by Zinnia Naqvi',
		body: 'Photobook addressing gender performance and colonial mimicry through the family archive. French and English signed editions.',
		specs: [
			'Smyth-sewn hardcover • linen • foil stamped',
			'Paper book band silkscreened with gold ink',
			'7 × 11 inches',
			'Published by Anchorless Press, 2022',
		],
		links: [{ href: 'https://zinnianaqvi.com', label: 'www.zinnianaqvi.com' }],
	},
	{
		title: 'In the Studio with Notman',
		author: 'Marisa Portolese',
		slug: 'in-the-studio-with-notman',
		imageAlt: 'In the Studio with Notman photobook',
		body: 'Photobook for Marisa Portolese’s In the Studio with Notman, in collaboration with the McCord Museum.',
		specs: [
			'10 × 12 inches • 92 pages',
			'Published by McCord Museum, 2018',
		],
		links: [{ href: 'https://www.marisaportolese.com', label: 'www.marisaportolese.com' }],
	},
	{
		title: 'How to Get to Pinchard’s Island',
		author: 'Adam Simms',
		slug: 'how-to-get-to-pinchards-island',
		imageAlt: 'How to Get to Pinchard’s Island booklet',
		body: 'Thesis text for MFA in studio arts, photography.',
		specs: ['4 × 5 inches • 32 pages', 'Self-published, 2021'],
		links: [{ href: '/pinchards-island', label: 'art.adamsimms.xyz/pinchards-island' }],
	},
	{
		title: 'Occurrence',
		slug: 'occurrence',
		imageAlt: 'Occurrence website',
		gallery: 'website' as const,
		body: 'Website for Occurrence, espace d’art et d’essai contemporains — Montreal artist-run centre dedicated to contemporary arts, with photography and image practices as an anchor.',
		specs: [],
		links: [{ href: 'https://occurrence.ca/', label: 'www.occurrence.ca' }],
	},
].map((project) => ({
	...project,
	gallery: 'gallery' in project ? project.gallery : undefined,
	author: 'author' in project ? project.author : undefined,
	specs: project.specs,
	links: project.links,
	images: project.slug ? galleryImages(project.slug) : [],
}));
---

<Base
	title={title}
	description={description}
	image={ogImage}
	imageAlt={ogImageAlt}
	variant="cv"
>
	<article class="collaborations">
		<header class="page-header">
			<h1>{title}</h1>
			{lead ? <p class="collaborations__lead">{lead}</p> : null}
		</header>

		<ul class="collaborations__list">
			{
				projects.map((project) => (
					<li class="collaborations__item">
						<div class="collaborations__copy">
							<h2 class="collaborations__title">{project.title}</h2>
							{project.author ? (
								<p class="collaborations__author">{project.author}</p>
							) : null}
							<p class="collaborations__body">{project.body}</p>
							{project.specs.length ? (
								<ul class="collaborations__specs">
									{project.specs.map((line) => (
										<li>{line}</li>
									))}
								</ul>
							) : null}
							{project.links.length ? (
								<ul class="collaborations__links">
									{project.links.map((link) => (
										<li>
											<a href={link.href}>{link.label}</a>
										</li>
									))}
								</ul>
							) : null}
						</div>

						{project.images.length > 0 ? (
							<ul
								class:list={[
									'collaborations__gallery',
									{ 'collaborations__gallery--website': project.gallery === 'website' },
								]}
								data-collab-gallery
								data-collab-title={project.title}
							>
								{project.images.map((src, index) => {
									const alt = `${project.imageAlt}${index === 0 ? '' : ` (${index + 1})`}`;
									return (
										<li>
											<button
												type="button"
												class="collaborations__zoom"
												data-collab-zoom
												data-index={index}
												aria-label={`View larger: ${alt}`}
											>
												<img
													src={src}
													alt={alt}
													loading={index === 0 ? 'eager' : 'lazy'}
													decoding="async"
												/>
											</button>
										</li>
									);
								})}
							</ul>
						) : (
							<figure class="collaborations__media collaborations__media--empty" aria-hidden="true" />
						)}
					</li>
				))
			}
		</ul>

		<section class="collaborations__hire">
			<h2 class="collaborations__hire-title">Let’s work together</h2>
			<p class="collaborations__availability">
				I’m available for artist books, catalogues, exhibition graphics, and websites. If you
				have a project in mind — let’s collaborate: <a data-email-mailto href="#">Email</a>.
			</p>
		</section>
	</article>

	<dialog class="collab-lightbox" aria-label="Enlarged image">
		<button type="button" class="collab-lightbox__close" data-collab-lightbox-close aria-label="Close">
			Close
		</button>
		<button
			type="button"
			class="collab-lightbox__nav collab-lightbox__nav--prev"
			data-collab-lightbox-prev
			aria-label="Previous image"
		>
			Prev
		</button>
		<button
			type="button"
			class="collab-lightbox__nav collab-lightbox__nav--next"
			data-collab-lightbox-next
			aria-label="Next image"
		>
			Next
		</button>
		<figure class="collab-lightbox__figure">
			<img class="collab-lightbox__img" alt="" />
			<figcaption class="collab-lightbox__caption">
				<span class="collab-lightbox__title" data-collab-lightbox-title></span>
				<span class="collab-lightbox__count" data-collab-lightbox-count></span>
			</figcaption>
		</figure>
	</dialog>
</Base>

<script>
	import { contactEmail } from '../lib/contact-email';

	function initCollabEmail() {
		const address = contactEmail();
		document.querySelectorAll('.collaborations__hire [data-email-mailto]').forEach((node) => {
			if (!(node instanceof HTMLAnchorElement)) return;
			node.href = `mailto:${address}`;
			if (!node.hasAttribute('data-keep-label')) node.textContent = address;
		});
	}

	function initCollabLightbox() {
		const dialog = document.querySelector('.collab-lightbox');
		if (!(dialog instanceof HTMLDialogElement)) return;

		const imgEl = dialog.querySelector('.collab-lightbox__img');
		const titleEl = dialog.querySelector('[data-collab-lightbox-title]');
		const countEl = dialog.querySelector('[data-collab-lightbox-count]');
		const closeBtn = dialog.querySelector('[data-collab-lightbox-close]');
		const prevBtn = dialog.querySelector('[data-collab-lightbox-prev]');
		const nextBtn = dialog.querySelector('[data-collab-lightbox-next]');
		if (
			!(imgEl instanceof HTMLImageElement) ||
			!(titleEl instanceof HTMLElement) ||
			!(countEl instanceof HTMLElement) ||
			!(prevBtn instanceof HTMLButtonElement) ||
			!(nextBtn instanceof HTMLButtonElement)
		) {
			return;
		}

		/** @type {{ src: string; alt: string }[]} */
		let slides = [];
		let index = 0;
		let title = '';

		const render = () => {
			const slide = slides[index];
			if (!slide) return;
			imgEl.src = slide.src;
			imgEl.alt = slide.alt;
			titleEl.textContent = title;
			const multi = slides.length > 1;
			countEl.textContent = multi ? `${index + 1} / ${slides.length}` : '';
			countEl.hidden = !multi;
			prevBtn.hidden = !multi;
			nextBtn.hidden = !multi;
			prevBtn.disabled = index <= 0;
			nextBtn.disabled = index >= slides.length - 1;
		};

		const openAt = (gallery, startIndex) => {
			if (!(gallery instanceof HTMLElement)) return;
			const buttons = [...gallery.querySelectorAll('[data-collab-zoom]')];
			slides = buttons
				.map((btn) => {
					const img = btn.querySelector('img');
					if (!(img instanceof HTMLImageElement) || !img.src) return null;
					return { src: img.currentSrc || img.src, alt: img.alt || '' };
				})
				.filter(Boolean);
			if (!slides.length) return;
			title = gallery.dataset.collabTitle || '';
			index = Math.max(0, Math.min(startIndex, slides.length - 1));
			render();
			if (!dialog.open) dialog.showModal();
		};

		const step = (delta) => {
			const next = index + delta;
			if (next < 0 || next >= slides.length) return;
			index = next;
			render();
		};

		if (!dialog.dataset.ready) {
			dialog.dataset.ready = 'true';

			closeBtn?.addEventListener('click', () => dialog.close());

			dialog.addEventListener('click', (event) => {
				if (event.target === dialog) dialog.close();
			});

			dialog.addEventListener('close', () => {
				imgEl.removeAttribute('src');
				titleEl.textContent = '';
				countEl.textContent = '';
				slides = [];
				index = 0;
				title = '';
			});

			prevBtn.addEventListener('click', () => step(-1));
			nextBtn.addEventListener('click', () => step(1));

			dialog.addEventListener('keydown', (event) => {
				if (!dialog.open) return;
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					step(-1);
				} else if (event.key === 'ArrowRight') {
					event.preventDefault();
					step(1);
				}
			});

			document.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;
				const btn = target.closest('[data-collab-zoom]');
				if (!(btn instanceof HTMLButtonElement)) return;
				const gallery = btn.closest('[data-collab-gallery]');
				if (!gallery) return;
				event.preventDefault();
				const start = Number(btn.dataset.index || '0');
				openAt(gallery, Number.isFinite(start) ? start : 0);
			});
		}
	}

	function initCollaborations() {
		initCollabEmail();
		initCollabLightbox();
	}

	document.addEventListener('astro:page-load', initCollaborations);
</script>
