---
import { ClientRouter, fade } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import {
	DEFAULT_DESCRIPTION,
	DEFAULT_OG_IMAGE_ALT,
	PERSON_IMAGE,
	PERSON_SAME_AS,
	SITE_NAME,
	SITE_URL,
	absoluteUrl,
	cleanPathname,
	metaDescription,
	socialImageUrl,
} from '../lib/seo';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	ogType?: 'website' | 'article';
	noindex?: boolean;
	variant?: 'default' | 'home' | 'work' | 'about' | 'cv' | 'writing';
	/** When false, omit the site footer (e.g. full-viewport works index). */
	footer?: boolean;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	title = SITE_NAME,
	description,
	image,
	imageAlt,
	ogType = 'website',
	noindex = false,
	variant = 'default',
	footer = true,
	jsonLd,
} = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const desc = metaDescription(description);
const canonical = absoluteUrl(cleanPathname(Astro.url.pathname), Astro.site?.href || SITE_URL);
const usingDefaultImage = !image?.trim();
const ogImage = socialImageUrl(image);
const ogImageAlt =
	imageAlt?.trim() ||
	(usingDefaultImage || title === SITE_NAME
		? DEFAULT_OG_IMAGE_ALT
		: `${title} by Adam Simms`);
const robots = noindex ? 'noindex, nofollow' : 'index, follow';

const personLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_NAME,
	url: SITE_URL,
	jobTitle: 'Media artist',
	description: DEFAULT_DESCRIPTION,
	image: PERSON_IMAGE,
	sameAs: [...PERSON_SAME_AS],
	affiliation: {
		'@type': 'Organization',
		name: 'Concordia University',
		url: 'https://www.concordia.ca/',
	},
};

const websiteLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_NAME,
	url: SITE_URL,
	description: DEFAULT_DESCRIPTION,
	publisher: { '@type': 'Person', name: SITE_NAME, url: SITE_URL, image: PERSON_IMAGE },
};

const structuredData = [
	websiteLd,
	personLd,
	...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];

const isHome = variant === 'home';
const isWork = variant === 'work';
const isAbout = variant === 'about';
const isCv = variant === 'cv';
const isWriting = variant === 'writing';
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: '600ms' })}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=berry-orange" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=berry-orange" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=berry-orange" />
		<link rel="shortcut icon" href="/favicon.ico?v=berry-orange" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=berry-orange" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fafafa" />
		<meta name="description" content={desc} />
		<meta name="robots" content={robots} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={desc} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content="en_CA" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={desc} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<link rel="preconnect" href="https://media.adamsimms.xyz" />
		<link rel="preconnect" href="https://cloudberry-images.adamsimms.xyz" />
		<link rel="preconnect" href="https://cloudberry-thumbs.adamsimms.xyz" />
		<link
			rel="preload"
			href="/fonts/google-sans-flex-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		{
			!isHome && (
				<link
					rel="preload"
					href="/fonts/inter-latin.woff2?v=2"
					as="font"
					type="font/woff2"
					crossorigin
				/>
			)
		}
		<title>{pageTitle}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<ClientRouter />
		<!-- umami-analytics:start -->
		<script
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="096c186e-d7b2-4db1-8e73-d85176fdbe33"
			data-domains="adamsimms.xyz,syllabi.adamsimms.xyz,art.adamsimms.xyz"
			data-do-not-track="true"></script>
		<!-- umami-analytics:end -->
		<script is:inline>
			(() => {
				const trackPage = () => {
					if (typeof navigator !== 'undefined' && navigator.webdriver) return;
					if (typeof umami === 'undefined' || typeof umami.track !== 'function') return;
					// SPA form: merge current page props (avoids bare/malformed payloads → 400)
					umami.track((props) => ({ ...props }));
				};
				// after-swap: ClientRouter navigations only (initial pageview is auto-tracked)
				document.addEventListener('astro:after-swap', trackPage);
			})();
		</script>
		<script>
			document.addEventListener('astro:page-load', () => {
				const project = document.querySelector('[data-project-reveal]');
				if (!(project instanceof HTMLElement)) return;
				project.removeAttribute('data-ready');
				requestAnimationFrame(() => {
					project.setAttribute('data-ready', '');
				});
			});
		</script>
	</head>
	<body class:list={[isHome && 'body--home', isWork && 'body--work', isAbout && 'body--about', isCv && 'body--cv', isWriting && 'body--writing']}>
		{
			isHome ? (
				<>
					<Nav />
					<main class="main--home">
						<slot />
					</main>
				</>
			) : (
				<>
					<div class="site-sheet">
						<Nav />
						<main
							class:list={[
								isWork && 'main--work',
								isAbout && 'main--about',
								isCv && 'main--cv',
								isWriting && 'main--writing',
							]}
						>
							<slot />
						</main>
					</div>
					{footer ? <Footer /> : null}
				</>
			)
		}
	</body>
</html>
