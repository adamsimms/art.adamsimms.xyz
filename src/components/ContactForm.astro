---
interface Props {
	/** Destination set in JS via contact-email helper */
	id?: string;
}

const { id = 'contact' } = Astro.props;
---

<section class="contact" id={id} aria-labelledby="contact-heading">
	<h2 id="contact-heading">Contact</h2>

	<form class="contact-form" method="POST" action="#" data-contact-form>
		<input type="hidden" name="_subject" value="Message from art.adamsimms.xyz" />
		<input type="hidden" name="_template" value="table" />
		<input type="hidden" name="_captcha" value="false" />
		<input
			type="text"
			name="_honey"
			class="contact-honey"
			tabindex="-1"
			autocomplete="off"
			aria-hidden="true"
		/>

		<div class="contact-row">
			<label>
				<span>First name</span>
				<input type="text" name="first_name" required autocomplete="given-name" />
			</label>
			<label>
				<span>Last name</span>
				<input type="text" name="last_name" required autocomplete="family-name" />
			</label>
		</div>

		<label>
			<span>Email address</span>
			<input type="email" name="email" required autocomplete="email" />
		</label>

		<label>
			<span>Message</span>
			<textarea name="message" rows="6" required></textarea>
		</label>

		<div class="contact-actions">
			<button type="submit">Send</button>
			<p class="contact-status" data-contact-status hidden></p>
		</div>
	</form>
</section>

<script>
	import { contactEmail, formSubmitEndpoint } from '../lib/contact-email';

	function initContactForms() {
		document.querySelectorAll('[data-contact-form]').forEach((node) => {
			if (!(node instanceof HTMLFormElement)) return;

			node.action = formSubmitEndpoint();

			if (node.dataset.enhanced === 'true') return;
			node.dataset.enhanced = 'true';

			const status = node.querySelector('[data-contact-status]');
			if (!(status instanceof HTMLElement)) return;

			node.addEventListener('submit', async (event) => {
				event.preventDefault();
				const button = node.querySelector('button[type="submit"]');
				if (button instanceof HTMLButtonElement) button.disabled = true;
				status.hidden = false;
				status.textContent = 'Sending…';
				status.dataset.state = 'pending';

				try {
					const response = await fetch(node.action, {
						method: 'POST',
						body: new FormData(node),
						headers: { Accept: 'application/json' },
					});

					if (!response.ok) throw new Error(`Submit failed (${response.status})`);

					node.reset();
					status.textContent = 'Thank you!';
					status.dataset.state = 'success';
					if (typeof window.ghostpane === 'function') {
						window.ghostpane('Contact');
					}
				} catch {
					status.textContent = `Unable to send. Please email ${contactEmail()}.`;
					status.dataset.state = 'error';
				} finally {
					if (button instanceof HTMLButtonElement) button.disabled = false;
				}
			});
		});
	}

	document.addEventListener('astro:page-load', initContactForms);
</script>
