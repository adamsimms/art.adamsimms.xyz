---
import { getCollection } from 'astro:content';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const work = await getCollection('work');
const workPaths = new Set(['/works', ...work.map((entry) => `/${entry.data.slug}`)]);

const links = [
	{ href: '/works', label: 'Works', current: workPaths.has(current) },
	{ href: '/about', label: 'About', current: current === '/about' },
	{ href: '/cv', label: 'CV', current: current === '/cv' },
];
---

<header class="site-header">
	<a class="site-title" href="/" aria-label="Adam Simms">
		<span class="site-title__mark" aria-hidden="true">
			<span class="site-title__mono">AS</span>
			<span class="site-title__full">Adam Simms</span>
		</span>
	</a>

	<nav class="site-nav" aria-label="Main">
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href} aria-current={link.current ? 'page' : undefined}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
