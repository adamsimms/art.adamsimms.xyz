---
import { hoverMediaUrl } from '../lib/media';

interface GalleryImage {
	src: string;
	fallback?: string;
	alt?: string;
	title?: string;
	date?: string;
	dimensions?: string;
	notes?: string;
	caption?: string;
}

interface GalleryVideo {
	id: string;
	title?: string;
	poster?: string;
	posterFallback?: string;
}

interface Props {
	images: GalleryImage[];
	title?: string;
	video?: GalleryVideo | null;
	/** Stack images vertically with no carousel controls. */
	layout?: 'carousel' | 'stack';
	/** Prefix for figure ids (default `image`). Use `still` for body stills. */
	idPrefix?: string;
}

const { images, title = '', video = null, layout = 'carousel', idPrefix = 'image' } = Astro.props;
const isStack = layout === 'stack';
const hasVideo = Boolean(video?.id);
const imageCount = images.length;
const total = imageCount + (hasVideo ? 1 : 0);
const showControls = !isStack && total > 1;

function trimField(value?: string) {
	return value?.trim() || '';
}

function imageAlt(image: GalleryImage, imageIndex: number) {
	const raw = image.alt?.trim() || '';
	const generic = !raw || (title && raw.toLowerCase() === title.toLowerCase());
	if (!generic) return raw;
	const n = imageIndex + 1;
	if (title && imageCount > 1) return `${title}, image ${n} of ${imageCount}`;
	if (title) return title;
	return imageCount > 1 ? `Gallery image ${n} of ${imageCount}` : 'Project image';
}

function imageCaption(image: GalleryImage) {
	const parts = [
		trimField(image.title),
		trimField(image.date),
		trimField(image.dimensions),
		trimField(image.notes),
		trimField(image.caption),
	].filter(Boolean);
	return parts.length ? parts.join(' • ') : null;
}

const vimeoSrc = hasVideo
	? `https://player.vimeo.com/video/${video!.id}?title=0&byline=0&portrait=0&autoplay=1`
	: '';
const videoTitle = video?.title || (title ? `${title} · video` : 'Project video');
const posterSrc = video?.poster || '';
const posterFallback = video?.posterFallback || posterSrc;
const posterHover = posterSrc ? hoverMediaUrl(posterSrc) : '';
const posterHoverFallback = posterFallback ? hoverMediaUrl(posterFallback) : '';
---

{
	total > 0 ? (
		<section
			class:list={[
				'gallery',
				isStack ? 'gallery--stack' : 'gallery--carousel',
				hasVideo && 'gallery--has-video',
			]}
			data-gallery
			tabindex={showControls ? '0' : undefined}
			aria-roledescription={showControls ? 'carousel' : undefined}
			aria-label={
				title
					? isStack
						? `${title} stills`
						: `${title} gallery`
					: isStack
						? 'Project stills'
						: 'Project gallery'
			}
		>
			<div class="gallery__viewport" data-gallery-viewport>
				{
					hasVideo ? (
						<figure
							class="gallery__item gallery__item--video"
							id={`${idPrefix}-1`}
							data-index="0"
							data-gallery-video
							data-active=""
							aria-hidden="false"
						>
							<div class="gallery__video-frame" data-gallery-video-shell>
								{
									posterFallback ? (
										<picture class="gallery__video-poster">
											{posterHover && posterSrc ? (
												<source
													type="image/avif"
													srcset={`${posterHover} 1280w, ${posterSrc} 1920w`}
													sizes="(max-width: 40rem) 100vw, min(100vw, 48rem)"
												/>
											) : posterSrc ? (
												<source type="image/avif" srcset={posterSrc} />
											) : null}
											<img
												src={posterHoverFallback || posterFallback}
												srcset={
													posterHoverFallback
														? `${posterHoverFallback} 1280w, ${posterFallback} 1920w`
														: undefined
												}
												sizes="(max-width: 40rem) 100vw, min(100vw, 48rem)"
												alt=""
												width="16"
												height="9"
												decoding="async"
												fetchpriority="high"
											/>
										</picture>
									) : null
								}
								<button
									type="button"
									class="gallery__video-play"
									data-gallery-video-play
									aria-label={`Play ${videoTitle}`}
								>
									<svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
										<path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
									</svg>
								</button>
								<iframe
									data-gallery-video-frame
									data-src={vimeoSrc}
									title={videoTitle}
									allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
									allowfullscreen
									tabindex="-1"
								/>
							</div>
						</figure>
					) : null
				}

				{images.map((image, imageIndex) => {
					const slideIndex = hasVideo ? imageIndex + 1 : imageIndex;
					const n = slideIndex + 1;
					const id = `${idPrefix}-${n}`;
					const isFirst = !hasVideo && imageIndex === 0;
					const caption = imageCaption(image);
					return (
						<figure
							class="gallery__item"
							id={id}
							data-index={String(slideIndex)}
							data-active={isStack || isFirst ? '' : undefined}
							aria-hidden={isStack || isFirst ? 'false' : 'true'}
						>
							<picture>
								<source srcset={image.src} type="image/avif" />
								<img
									src={image.fallback || image.src}
									alt={imageAlt(image, imageIndex)}
									width={isStack ? '16' : '3'}
									height={isStack ? '9' : '2'}
									loading={isFirst ? 'eager' : 'lazy'}
									decoding="async"
								/>
							</picture>
							{caption ? <figcaption class="gallery__caption">{caption}</figcaption> : null}
						</figure>
					);
				})}

				{
					showControls ? (
						<>
							<div class="gallery__controls" aria-label="Gallery navigation">
								<button
									type="button"
									class="gallery__hit gallery__hit--prev"
									data-gallery-prev
									aria-label="Previous slide"
									disabled
								>
									<span class="visually-hidden">Previous slide</span>
								</button>
								<button
									type="button"
									class="gallery__hit gallery__hit--next"
									data-gallery-next
									aria-label="Next slide"
								>
									<span class="visually-hidden">Next slide</span>
								</button>
							</div>

							<div class="gallery__cursor" data-gallery-cursor aria-hidden="true">
								<span class="gallery__cursor-chip">
									<svg class="gallery__cursor-arrow gallery__cursor-arrow--prev" viewBox="0 0 24 24" width="40" height="40" focusable="false">
										<path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"></path>
									</svg>
									<svg class="gallery__cursor-arrow gallery__cursor-arrow--next" viewBox="0 0 24 24" width="40" height="40" focusable="false">
										<path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"></path>
									</svg>
								</span>
							</div>

							<p class="gallery__count" data-gallery-count aria-live="polite"></p>
						</>
					) : null
				}
			</div>
		</section>
	) : null
}

<script>
	type GalleryNav = (direction: 'prev' | 'next') => void;
	type GalleryElement = HTMLElement & { galleryNav?: GalleryNav };

	function playVideoFrame(root: ParentNode) {
		const shell = root.querySelector('[data-gallery-video-shell]');
		const iframe = root.querySelector('[data-gallery-video-frame]');
		if (!(iframe instanceof HTMLIFrameElement)) return;
		if (shell instanceof HTMLElement && shell.hasAttribute('data-playing')) return;
		const src = iframe.getAttribute('data-src');
		if (!src) return;
		iframe.setAttribute('src', src);
		if (shell instanceof HTMLElement) shell.setAttribute('data-playing', '');
	}

	function bindVideoPlay(root: ParentNode, signal?: AbortSignal) {
		const finePointer = window.matchMedia('(pointer: fine)').matches;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		root.querySelectorAll('[data-gallery-video-play]').forEach((button) => {
			if (!(button instanceof HTMLButtonElement)) return;
			const icon = button.querySelector('svg');

			button.addEventListener(
				'click',
				(event) => {
					event.preventDefault();
					event.stopPropagation();
					const slide = button.closest('.gallery__item') || root;
					playVideoFrame(slide);
				},
				{ signal },
			);

			if (!finePointer || !(icon instanceof SVGElement)) return;

			const pos = { x: 0, y: 0, tx: 0, ty: 0 };
			let tracking = false;
			let frame = 0;

			const setIconPosition = () => {
				icon.style.left = Math.round(pos.x) + 'px';
				icon.style.top = Math.round(pos.y) + 'px';
				icon.style.transform = 'translate(-50%, -50%)';
			};

			const tick = () => {
				const accel = reduceMotion ? 1 : 0.22;
				pos.x += (pos.tx - pos.x) * accel;
				pos.y += (pos.ty - pos.y) * accel;
				setIconPosition();
				if (tracking) frame = requestAnimationFrame(tick);
			};

			const onMove = (event: PointerEvent) => {
				if (event.pointerType !== 'mouse') return;
				const rect = button.getBoundingClientRect();
				pos.tx = event.clientX - rect.left;
				pos.ty = event.clientY - rect.top;
				button.dataset.hovering = 'true';

				if (!tracking) {
					pos.x = pos.tx;
					pos.y = pos.ty;
					setIconPosition();
					tracking = true;
					cancelAnimationFrame(frame);
					frame = requestAnimationFrame(tick);
				}
			};

			const onLeave = () => {
				tracking = false;
				cancelAnimationFrame(frame);
				button.dataset.hovering = 'false';
				icon.style.left = '';
				icon.style.top = '';
				icon.style.transform = '';
			};

			button.addEventListener('pointerenter', onMove, { signal });
			button.addEventListener('pointermove', onMove, { signal });
			button.addEventListener('pointerleave', onLeave, { signal });
			signal?.addEventListener('abort', () => {
				tracking = false;
				cancelAnimationFrame(frame);
			});
		});
	}

	/** Align caption + count to the object-fit:contain photo, not the full carousel frame. */
	function measureContainBand(img: HTMLImageElement) {
		const boxW = img.clientWidth;
		const boxH = img.clientHeight;
		const natW = img.naturalWidth;
		const natH = img.naturalHeight;
		if (!boxW || !boxH || !natW || !natH) return null;

		const boxRatio = boxW / boxH;
		const imageRatio = natW / natH;
		let renderedW: number;
		let inset: number;
		if (imageRatio >= boxRatio) {
			renderedW = boxW;
			inset = 0;
		} else {
			renderedW = boxH * imageRatio;
			inset = (boxW - renderedW) / 2;
		}

		return {
			inset: `${Math.max(0, inset)}px`,
			width: `${renderedW}px`,
		};
	}

	function applyMetaBand(target: HTMLElement, inset: string, width: string) {
		target.style.setProperty('--caption-inset', inset);
		target.style.setProperty('--caption-width', width);
	}

	function clearMetaBand(target: HTMLElement) {
		target.style.removeProperty('--caption-inset');
		target.style.removeProperty('--caption-width');
	}

	function syncCaptionToImage(figure: Element) {
		if (!(figure instanceof HTMLElement)) return;

		// Video fills the frame; keep meta flush to the edges.
		if (figure.hasAttribute('data-gallery-video')) {
			applyMetaBand(figure, '0px', '100%');
			return;
		}

		const img = figure.querySelector('img');
		const caption = figure.querySelector('figcaption');
		if (!(img instanceof HTMLImageElement)) {
			clearMetaBand(figure);
			return;
		}

		// Still measure when there is no caption — the count needs the same band.
		const band = measureContainBand(img);
		if (!band) {
			if (!(caption instanceof HTMLElement)) clearMetaBand(figure);
			return;
		}

		applyMetaBand(figure, band.inset, band.width);
	}

	function syncActiveMetaBand(gallery: HTMLElement) {
		const viewport = gallery.querySelector('[data-gallery-viewport]');
		const active = gallery.querySelector('.gallery__item[data-active]');
		if (!(viewport instanceof HTMLElement)) return;
		if (!(active instanceof HTMLElement)) {
			clearMetaBand(viewport);
			return;
		}

		syncCaptionToImage(active);
		const inset = active.style.getPropertyValue('--caption-inset') || '0px';
		const width = active.style.getPropertyValue('--caption-width') || '100%';
		applyMetaBand(viewport, inset, width);
	}

	function bindCaptionAlignment(gallery: HTMLElement, signal?: AbortSignal) {
		const figures = [...gallery.querySelectorAll('.gallery__item')];
		const syncAll = () => {
			figures.forEach(syncCaptionToImage);
			syncActiveMetaBand(gallery);
		};

		figures.forEach((figure) => {
			if (!(figure instanceof HTMLElement)) return;
			if (figure.hasAttribute('data-gallery-video')) {
				syncCaptionToImage(figure);
				return;
			}
			const img = figure.querySelector('img');
			if (!(img instanceof HTMLImageElement)) return;
			if (img.complete) syncCaptionToImage(figure);
			else img.addEventListener('load', () => {
				syncCaptionToImage(figure);
				syncActiveMetaBand(gallery);
			}, { once: true, signal });
		});

		const ro = new ResizeObserver(syncAll);
		const viewport = gallery.querySelector('[data-gallery-viewport]');
		if (viewport instanceof HTMLElement) ro.observe(viewport);
		else ro.observe(gallery);

		signal?.addEventListener('abort', () => ro.disconnect());
		window.addEventListener('resize', syncAll, { signal });
		syncAll();
	}

	function enhanceCarousel(gallery: HTMLElement) {
		if (gallery.hasAttribute('data-enhanced')) return;

		const viewport = gallery.querySelector('[data-gallery-viewport]');
		const slides = [...gallery.querySelectorAll('.gallery__item')];
		const prevBtn = gallery.querySelector('[data-gallery-prev]');
		const nextBtn = gallery.querySelector('[data-gallery-next]');
		const cursor = gallery.querySelector('[data-gallery-cursor]');
		const countEl = gallery.querySelector('[data-gallery-count]');
		if (
			!(viewport instanceof HTMLElement) ||
			!slides.length ||
			!(prevBtn instanceof HTMLButtonElement) ||
			!(nextBtn instanceof HTMLButtonElement) ||
			!(cursor instanceof HTMLElement)
		) {
			return;
		}

		const totalSlides = slides.length;
		const finePointer = window.matchMedia('(pointer: fine)').matches;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const AUTOPLAY_MS = 7000;
		const EDGE_RATIO = 0.18;
		const SWIPE_MIN = 48;
		let index = 0;
		let side = 'next';
		let tracking = false;
		let frame = 0;
		let autoplayTimer = 0;
		let hovered = false;
		const pos = { x: 0, y: 0, tx: 0, ty: 0 };
		const swipe = { id: -1, x: 0, y: 0, armed: false, ignoreClickUntil: 0 };
		const ac = new AbortController();
		const { signal } = ac;

		const isVideoSlide = (i: number) =>
			slides[i] instanceof HTMLElement && slides[i].hasAttribute('data-gallery-video');

		const parseHash = () => {
			const match = /^#image-(\d+)$/.exec(location.hash);
			if (!match) return null;
			const n = Number(match[1]);
			if (!Number.isInteger(n) || n < 1 || n > totalSlides) return null;
			return n - 1;
		};

		const setHash = (i: number) => {
			const nextHash = '#image-' + (i + 1);
			if (location.hash === nextHash) return;
			history.replaceState(null, '', location.pathname + location.search + nextHash);
		};

		const canGo = (direction: string) => (direction === 'prev' ? index > 0 : index < totalSlides - 1);

		const stopAutoplay = () => {
			window.clearInterval(autoplayTimer);
			autoplayTimer = 0;
		};

		const startAutoplay = () => {
			stopAutoplay();
			if (reduceMotion || totalSlides < 2) return;
			if (hovered || document.hidden) return;
			if (isVideoSlide(index)) return;
			if (index >= totalSlides - 1) return;

			autoplayTimer = window.setInterval(() => {
				if (hovered || document.hidden) return;
				if (isVideoSlide(index) || index >= totalSlides - 1) {
					stopAutoplay();
					return;
				}
				goTo(index + 1);
			}, AUTOPLAY_MS);
		};

		const updateCursor = () => {
			const disabled = !canGo(side);
			cursor.dataset.side = side;
			cursor.dataset.disabled = disabled ? 'true' : 'false';
			if (cursor.dataset.active === 'true') {
				viewport.dataset.cursor = 'true';
			}
		};

		const syncVideoMode = () => {
			if (isVideoSlide(index)) viewport.setAttribute('data-video-active', '');
			else viewport.removeAttribute('data-video-active');
		};

		const edgeSide = (clientX: number) => {
			const rect = viewport.getBoundingClientRect();
			const x = clientX - rect.left;
			const edge = rect.width * EDGE_RATIO;
			if (x <= edge) return 'prev';
			if (x >= rect.width - edge) return 'next';
			return null;
		};

		const goTo = (next: number, options?: { updateHash?: boolean; restartAutoplay?: boolean }) => {
			const updateHash = !options || options.updateHash !== false;
			const restartAutoplay = !options || options.restartAutoplay !== false;
			const clamped = Math.max(0, Math.min(totalSlides - 1, next));
			index = clamped;

			slides.forEach((slide, i) => {
				const active = i === index;
				if (active) slide.setAttribute('data-active', '');
				else slide.removeAttribute('data-active');
				slide.setAttribute('aria-hidden', active ? 'false' : 'true');
			});

			prevBtn.disabled = index === 0;
			nextBtn.disabled = index === totalSlides - 1;
			syncVideoMode();
			updateCursor();
			if (countEl instanceof HTMLElement) {
				countEl.textContent = `${index + 1} / ${totalSlides}`;
			}
			syncActiveMetaBand(gallery);

			if (updateHash) setHash(index);
			if (restartAutoplay) startAutoplay();
			else stopAutoplay();
		};

		const setCursorPosition = () => {
			const halfW = cursor.offsetWidth / 2;
			const halfH = cursor.offsetHeight / 2;
			cursor.style.left = Math.round(pos.x) - halfW + 'px';
			cursor.style.top = Math.round(pos.y) - halfH + 'px';
			cursor.style.transform = 'none';
		};

		const tick = () => {
			const accel = reduceMotion ? 1 : 0.22;
			pos.x += (pos.tx - pos.x) * accel;
			pos.y += (pos.ty - pos.y) * accel;
			setCursorPosition();
			if (tracking) frame = requestAnimationFrame(tick);
		};

		const showCursor = (clientX: number, clientY: number, forcedSide?: string | null) => {
			const rect = viewport.getBoundingClientRect();
			pos.tx = clientX - rect.left;
			pos.ty = clientY - rect.top;
			side = forcedSide || (pos.tx < rect.width / 2 ? 'prev' : 'next');
			cursor.dataset.active = 'true';
			updateCursor();

			if (!tracking) {
				pos.x = pos.tx;
				pos.y = pos.ty;
				setCursorPosition();
				tracking = true;
				cancelAnimationFrame(frame);
				frame = requestAnimationFrame(tick);
			}
		};

		const hideCursor = () => {
			tracking = false;
			cancelAnimationFrame(frame);
			cursor.dataset.active = 'false';
			viewport.dataset.cursor = 'false';
		};

		const cleanup = () => {
			stopAutoplay();
			cancelAnimationFrame(frame);
			ac.abort();
		};

		gallery.setAttribute('data-enhanced', '');

		const fromHash = parseHash();
		goTo(fromHash == null ? 0 : fromHash, {
			updateHash: fromHash != null,
			restartAutoplay: fromHash == null ? !isVideoSlide(0) : undefined,
		});

		bindCaptionAlignment(gallery, signal);
		bindVideoPlay(gallery, signal);

		const suppressSwipeClick = (event: Event) => {
			if (performance.now() > swipe.ignoreClickUntil) return;
			event.preventDefault();
			event.stopPropagation();
			swipe.ignoreClickUntil = 0;
		};

		viewport.addEventListener('click', suppressSwipeClick, { capture: true, signal });

		prevBtn.addEventListener(
			'click',
			() => {
				goTo(index - 1);
				// Drop focus so a following arrow key doesn't paint the focus ring on the edge hit zone.
				prevBtn.blur();
			},
			{ signal },
		);

		nextBtn.addEventListener(
			'click',
			() => {
				goTo(index + 1);
				nextBtn.blur();
			},
			{ signal },
		);

		viewport.addEventListener(
			'pointerdown',
			(event) => {
				if (event.pointerType === 'mouse') return;
				if (event.button !== 0 && event.pointerType === 'pen') return;
				swipe.id = event.pointerId;
				swipe.x = event.clientX;
				swipe.y = event.clientY;
				swipe.armed = true;
			},
			{ signal },
		);

		viewport.addEventListener(
			'pointermove',
			(event) => {
				if (!swipe.armed || event.pointerId !== swipe.id) return;
				const dx = event.clientX - swipe.x;
				const dy = event.clientY - swipe.y;
				if (Math.abs(dx) < 12 && Math.abs(dy) < 12) return;
				if (Math.abs(dy) >= Math.abs(dx)) swipe.armed = false;
			},
			{ signal },
		);

		const endSwipe = (event: PointerEvent) => {
			if (!swipe.armed || event.pointerId !== swipe.id) return;
			const dx = event.clientX - swipe.x;
			const dy = event.clientY - swipe.y;
			swipe.armed = false;
			if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) <= Math.abs(dy)) return;
			swipe.ignoreClickUntil = performance.now() + 450;
			if (dx < 0) goTo(index + 1);
			else goTo(index - 1);
		};

		viewport.addEventListener('pointerup', endSwipe, { signal });
		viewport.addEventListener(
			'pointercancel',
			(event) => {
				if (event.pointerId !== swipe.id) return;
				swipe.armed = false;
			},
			{ signal },
		);

		viewport.addEventListener(
			'pointerenter',
			(event) => {
				hovered = true;
				stopAutoplay();
				if (finePointer && event.pointerType === 'mouse') {
					if (isVideoSlide(index)) {
						const edge = edgeSide(event.clientX);
						if (edge) showCursor(event.clientX, event.clientY, edge);
						else hideCursor();
					} else {
						showCursor(event.clientX, event.clientY);
					}
				}
			},
			{ signal },
		);

		if (finePointer) {
			viewport.addEventListener(
				'pointermove',
				(event) => {
					if (event.pointerType !== 'mouse') return;
					if (isVideoSlide(index)) {
						const edge = edgeSide(event.clientX);
						if (edge) showCursor(event.clientX, event.clientY, edge);
						else hideCursor();
						return;
					}
					showCursor(event.clientX, event.clientY);
				},
				{ signal },
			);
		}

		viewport.addEventListener(
			'pointerleave',
			(event) => {
				hovered = false;
				if (finePointer && event.pointerType === 'mouse') hideCursor();
				startAutoplay();
			},
			{ signal },
		);

		document.addEventListener(
			'visibilitychange',
			() => {
				if (document.hidden) stopAutoplay();
				else startAutoplay();
			},
			{ signal },
		);

		// Expose navigation so a single page-level keydown listener can drive this carousel
		// from anywhere on the page (no need to focus the carousel first).
		(gallery as GalleryElement).galleryNav = (direction) => {
			goTo(direction === 'prev' ? index - 1 : index + 1);
		};
		signal.addEventListener('abort', () => {
			delete (gallery as GalleryElement).galleryNav;
		});

		window.addEventListener(
			'hashchange',
			() => {
				const fromHashChange = parseHash();
				if (fromHashChange != null) goTo(fromHashChange, { updateHash: false });
			},
			{ signal },
		);

		document.addEventListener('astro:before-swap', cleanup, { once: true });
	}

	/** Choose the enhanced carousel currently visible + nearest the viewport centre. */
	function pickActiveGallery(): GalleryElement | null {
		const galleries = [...document.querySelectorAll<GalleryElement>('[data-gallery][data-enhanced]')].filter(
			(gallery) => typeof gallery.galleryNav === 'function',
		);
		if (!galleries.length) return null;

		const viewportH = window.innerHeight || document.documentElement.clientHeight;
		let best: GalleryElement | null = null;
		let bestDist = Infinity;
		for (const gallery of galleries) {
			const rect = gallery.getBoundingClientRect();
			if (rect.bottom <= 0 || rect.top >= viewportH) continue;
			const dist = Math.abs(rect.top + rect.height / 2 - viewportH / 2);
			if (dist < bestDist) {
				bestDist = dist;
				best = gallery;
			}
		}
		return best;
	}

	let keyboardBound = false;
	function bindGlobalKeyboard() {
		if (keyboardBound) return;
		keyboardBound = true;
		document.addEventListener('keydown', (event) => {
			if (event.defaultPrevented) return;
			if (event.altKey || event.ctrlKey || event.metaKey) return;
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;

			const target = event.target;
			if (target instanceof HTMLElement) {
				if (target.isContentEditable) return;
				const tag = target.tagName;
				if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
			}

			const gallery = pickActiveGallery();
			if (!gallery?.galleryNav) return;

			event.preventDefault();
			gallery.galleryNav(event.key === 'ArrowLeft' ? 'prev' : 'next');
		});
	}

	function initGalleries() {
		bindGlobalKeyboard();
		document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
			const hasControls = gallery.querySelector('[data-gallery-prev]');
			if (hasControls) {
				enhanceCarousel(gallery);
				return;
			}
			const ac = new AbortController();
			bindCaptionAlignment(gallery, ac.signal);
			bindVideoPlay(gallery, ac.signal);
			document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
		});
	}

	document.addEventListener('astro:page-load', initGalleries);
	initGalleries();
</script>
