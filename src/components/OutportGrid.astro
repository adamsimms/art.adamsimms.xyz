---
import OutportVideo from './OutportVideo.astro';
import { inlineMarkdown } from '../lib/inlineMarkdown';
import { spaceHeight, textAlignAxes, type OutportRowAlign, type OutportTextAlign } from '../lib/outport';

interface Props {
	rows: Array<{ cells: OutportCell[] }>;
	/** First image on the page loads eagerly. */
	eagerImage?: boolean;
}

const { rows, eagerImage = false } = Astro.props;

let imageSeen = false;

function textClass(style: string, span: number): string {
	const classes = ['outport-text', `outport-text--${style}`];
	if (style === 'title') classes.push(`outport-text--title-span-${span}`);
	return classes.join(' ');
}

function textParagraphs(body: string): string[] {
	return body.trim().split(/\n\n+/).filter(Boolean);
}

function textCellStyle(cell: {
	span: number;
	background?: string;
	color?: string;
}): string {
	const parts = [`--span: ${cell.span}`];
	if (cell.background) parts.push(`background-color: ${cell.background}`);
	if (cell.color) parts.push(`--outport-text-fg: ${cell.color}`);
	return parts.join('; ');
}

function rowAlignClass(align?: OutportRowAlign): string {
	return align === 'bottom' ? 'outport-cell--align-bottom' : '';
}
---

<div class="outport-log" data-outport-log>
	{
		rows.map((row) => (
			<div class="outport-row" data-outport-row>
				{row.cells.map((cell) => {
					if (cell.type === 'empty') {
						return (
							<div
								class:list={['outport-cell', 'outport-cell--empty', rowAlignClass(cell.align)]}
								style={`--span: ${cell.span}`}
								aria-hidden="true"
							/>
						);
					}

					if (cell.type === 'space') {
						return (
							<div
								class="outport-cell outport-cell--space"
								style={`--span: 4; --outport-space: ${spaceHeight(cell.size)}`}
								aria-hidden="true"
							/>
						);
					}

					if (cell.type === 'text') {
						const style = cell.style ?? 'small';
						const axes = textAlignAxes(cell.align as OutportTextAlign | undefined);
						const paragraphs = textParagraphs(cell.body);
						const multi = paragraphs.length > 1;
						return (
							<div
								class:list={[
									'outport-cell',
									'outport-cell--text',
									cell.border && 'outport-cell--text-bordered',
								]}
								style={textCellStyle(cell)}
								data-span={cell.span}
								data-align-x={axes.x}
								data-align-y={axes.y}
							>
								{style === 'quote' ? (
									<blockquote class={textClass(style, cell.span)}>
										<p set:html={inlineMarkdown(cell.body)} />
										{cell.attrib ? (
											<cite class="outport-text__attrib">{cell.attrib}</cite>
										) : null}
									</blockquote>
								) : multi ? (
									<div class={textClass(style, cell.span)}>
										{paragraphs.map((paragraph) => (
											<p set:html={inlineMarkdown(paragraph)} />
										))}
									</div>
								) : (
									<p
										class={textClass(style, cell.span)}
										set:html={inlineMarkdown(cell.body)}
									/>
								)}
							</div>
						);
					}

					if (cell.type === 'image') {
						const eager = eagerImage && !imageSeen;
						if (eager) imageSeen = true;
						return (
							<figure
								class:list={[
									'outport-cell',
									'outport-cell--image',
									'outport-media',
									rowAlignClass(cell.align),
								]}
								style={`--span: ${cell.span}; aspect-ratio: ${cell.width} / ${cell.height}`}
							>
								<picture>
									{cell.src.endsWith('.avif') ? (
										<source srcset={cell.src} type="image/avif" />
									) : null}
									<img
										src={cell.fallback}
										alt={cell.alt}
										width={cell.width}
										height={cell.height}
										loading={eager ? 'eager' : 'lazy'}
										decoding="async"
									/>
								</picture>
								{cell.caption ? (
									<figcaption class="outport-media__caption">{cell.caption}</figcaption>
								) : null}
								{cell.people?.length ? (
									<p class="outport-media__people">{cell.people.join(' · ')}</p>
								) : null}
							</figure>
						);
					}

					if (cell.type === 'video') {
						return (
							<div
								class:list={['outport-cell', 'outport-cell--video', rowAlignClass(cell.align)]}
								style={`--span: ${cell.span}`}
							>
								<OutportVideo cell={cell} />
							</div>
						);
					}

					return null;
				})}
			</div>
		))
	}
</div>

<script>
	function revealRowsInSection(section: HTMLElement | null) {
		if (!section) return;
		section.querySelectorAll<HTMLElement>('[data-outport-row]').forEach((row) => {
			row.dataset.visible = '';
		});
	}

	function revealRowsAboveHash() {
		const hash = window.location.hash.replace(/^#/, '');
		if (!hash) return;

		const sections = document.querySelectorAll<HTMLElement>('.outport-entries section[id]');
		for (const section of sections) {
			revealRowsInSection(section);
			if (section.id === hash) break;
		}
	}

	function initOutportReveal() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			document.querySelectorAll<HTMLElement>('[data-outport-row]').forEach((row) => {
				row.dataset.visible = '';
			});
			return;
		}

		const rows = document.querySelectorAll<HTMLElement>('[data-outport-row]');
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					(entry.target as HTMLElement).dataset.visible = '';
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.12, rootMargin: '0px 0px -5% 0px' },
		);

		rows.forEach((row) => {
			if (row.dataset.visible === '') return;
			observer.observe(row);
		});

		revealRowsAboveHash();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initOutportReveal);
	} else {
		initOutportReveal();
	}

	document.addEventListener('astro:page-load', initOutportReveal);
	window.addEventListener('hashchange', revealRowsAboveHash);
</script>
