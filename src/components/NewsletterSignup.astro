---
/**
 * Footer newsletter signup → Cloudflare Worker (pfstr template).
 * Override with PUBLIC_NEWSLETTER_URL (no trailing slash).
 * Turnstile site key: PUBLIC_TURNSTILE_SITE_KEY.
 */
const DEFAULT_NEWSLETTER_URL = 'https://art.adamsimms.xyz/newsletter';
const DEFAULT_TURNSTILE_SITE_KEY = '0x4AAAAAAFZZWzAOqKSLz41Y';
const endpoint = (
	import.meta.env.PUBLIC_NEWSLETTER_URL || DEFAULT_NEWSLETTER_URL
).replace(/\/$/, '');
const turnstileSiteKey =
	import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || DEFAULT_TURNSTILE_SITE_KEY;
---

<form
	class="site-footer__newsletter"
	data-newsletter-form
	data-turnstile-sitekey={turnstileSiteKey}
	method="post"
	action={`${endpoint}/api/subscribe`}
>
	<label class="site-footer__newsletter-label" for="newsletter-email">Newsletter</label>
	<div class="site-footer__newsletter-row">
		<input
			id="newsletter-email"
			type="email"
			name="email"
			required
			autocomplete="email"
			placeholder="Email"
			aria-describedby="newsletter-status"
		/>
		<button type="submit">Subscribe</button>
	</div>
	<input
		class="site-footer__newsletter-trap"
		type="text"
		name="website"
		tabindex="-1"
		autocomplete="off"
		aria-hidden="true"
	/>
	<div class="site-footer__newsletter-challenge" data-turnstile-slot></div>
	<p class="site-footer__newsletter-status" id="newsletter-status" data-newsletter-status hidden></p>
</form>

<script>
	type Turnstile = {
		render: (el: HTMLElement, options: Record<string, unknown>) => string;
		execute: (el: HTMLElement) => void;
		reset: (widgetId: string) => void;
	};

	const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
	let turnstileLoad: Promise<Turnstile> | undefined;

	function loadTurnstile(): Promise<Turnstile> {
		turnstileLoad ??= new Promise((resolve, reject) => {
			const existing = (window as { turnstile?: Turnstile }).turnstile;
			if (existing) return resolve(existing);
			const script = document.createElement('script');
			script.src = TURNSTILE_SRC;
			script.async = true;
			script.onload = () => {
				const loaded = (window as { turnstile?: Turnstile }).turnstile;
				if (loaded) resolve(loaded);
				else reject(new Error('turnstile'));
			};
			script.onerror = () => {
				turnstileLoad = undefined;
				reject(new Error('turnstile'));
			};
			document.head.append(script);
		});
		return turnstileLoad;
	}

	function initNewsletterForms() {
		document.querySelectorAll('[data-newsletter-form]').forEach((node) => {
			if (!(node instanceof HTMLFormElement)) return;
			if (node.dataset.enhanced === 'true') return;
			node.dataset.enhanced = 'true';

			const status = node.querySelector('[data-newsletter-status]');
			if (!(status instanceof HTMLElement)) return;
			const slot = node.querySelector('[data-turnstile-slot]');
			const sitekey = node.dataset.turnstileSitekey;

			let widgetId: string | undefined;
			let pending: { resolve: (token: string) => void; reject: (err: Error) => void } | undefined;

			// Tokens are single-use: each submit renders or resets the widget and
			// waits for a fresh one. Interaction-only keeps it invisible unless
			// Cloudflare needs the visitor to click.
			async function requestToken(): Promise<string> {
				if (!sitekey || !(slot instanceof HTMLElement)) return '';
				const turnstile = await loadTurnstile();
				return new Promise((resolve, reject) => {
					pending = { resolve, reject };
					if (widgetId === undefined) {
						widgetId = turnstile.render(slot, {
							sitekey,
							action: 'signup',
							appearance: 'interaction-only',
							execution: 'execute',
							callback: (token: string) => pending?.resolve(token),
							'error-callback': () => pending?.reject(new Error('turnstile')),
							'expired-callback': () => pending?.reject(new Error('turnstile')),
						});
					} else {
						turnstile.reset(widgetId);
					}
					turnstile.execute(slot);
				});
			}

			node.addEventListener('focusin', () => {
				loadTurnstile().catch(() => {});
			}, { once: true });

			node.addEventListener('submit', async (event) => {
				event.preventDefault();
				const button = node.querySelector('button[type="submit"]');
				if (button instanceof HTMLButtonElement) button.disabled = true;
				status.hidden = false;
				status.textContent = 'Subscribing…';
				status.dataset.state = 'pending';

				try {
					const emailInput = node.querySelector('input[name="email"]');
					const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
					const trapInput = node.querySelector('input[name="website"]');
					const website = trapInput instanceof HTMLInputElement ? trapInput.value : '';
					const token = await requestToken();
					const response = await fetch(node.action, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
						body: JSON.stringify({ email, website, 'cf-turnstile-response': token }),
					});
					const payload = await response.json().catch(() => ({}));

					if (!response.ok) {
						status.textContent =
							payload.error === 'failed_captcha'
								? 'Verification failed. Please try again.'
								: 'Please check your email address.';
						status.dataset.state = 'error';
						return;
					}

					node.reset();
					status.textContent = payload.pending
						? 'Check your inbox to confirm.'
						: 'You’re on the list.';
					status.dataset.state = 'success';
					if (typeof window.ghostpane === 'function') {
						window.ghostpane('Signup', { props: { source: 'newsletter' } });
					}
				} catch {
					status.textContent = 'Unable to subscribe. Try again later.';
					status.dataset.state = 'error';
				} finally {
					if (button instanceof HTMLButtonElement) button.disabled = false;
				}
			});
		});
	}

	document.addEventListener('astro:page-load', initNewsletterForms);
</script>
